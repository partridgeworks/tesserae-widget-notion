{
  "tesserae_compat": "1.x",
  "name": "Notion, Projects",
  "version": "0.5.1",
  "kind": "widget",
  "description": "Active projects from any Notion database, with status, owner, target date and a progress bar where your database tracks one. Auto-detects which columns hold status, progress, date and owner. Supports several Notion accounts. Requires the Notion Core plugin.",
  "icon": "ph-kanban",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:api.notion.com",
    "settings:plugin/notion_core"
  ],
  "render": {
    "needs_network": false
  },
  "cell_options": [
    {
      "name": "data_source",
      "type": "select",
      "label": "Database",
      "default": "",
      "choices_from": "data_sources",
      "help": "Every database your Notion accounts can see, prefixed by account name when more than one is configured. Picking one also selects that account: a Notion database belongs to exactly one workspace, so there is nothing else to choose. Nothing listed? Open the database in Notion, then \u2022\u2022\u2022 \u2192 Connections \u2192 add your integration."
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "placeholder": "Projects",
      "default": "Projects"
    },
    {
      "name": "limit",
      "type": "select",
      "label": "Max projects shown",
      "default": "6",
      "choices": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "16",
          "label": "16"
        }
      ]
    },
    {
      "name": "refresh_min",
      "type": "select",
      "label": "Refresh",
      "default": "15",
      "choices": [
        {
          "value": "5",
          "label": "Every 5 min"
        },
        {
          "value": "15",
          "label": "Every 15 min"
        },
        {
          "value": "60",
          "label": "Hourly"
        }
      ]
    },
    {
      "name": "show_progress",
      "type": "boolean",
      "label": "Show progress bars",
      "default": true
    },
    {
      "name": "show_due",
      "type": "boolean",
      "label": "Show target dates",
      "default": true
    },
    {
      "name": "show_owner",
      "type": "boolean",
      "label": "Show owner",
      "default": false
    },
    {
      "name": "show_completed",
      "type": "boolean",
      "label": "Include completed projects",
      "default": false
    },
    {
      "name": "filter_person",
      "type": "string",
      "label": "Only show items for",
      "default": "",
      "placeholder": "me",
      "help": "Leave blank to show everything. Type 'me' for whoever owns the Notion token (exact, and filtered by Notion itself), or a person's name as it appears in Notion."
    },
    {
      "name": "filter_columns",
      "type": "string",
      "label": "Filter columns (blank = the people column)",
      "default": "",
      "placeholder": "Assignee, Collaborators",
      "help": "Comma-separated Notion column names, e.g. 'Assignee, Collaborators'. A row is kept if ANY of them matches. Blank uses the auto-detected people column. The Notion Core admin page's Inspect columns link lists the exact names."
    },
    {
      "name": "status_prop",
      "type": "string",
      "label": "Status column (blank = auto-detect)",
      "default": "",
      "help": "Only needed if auto-detection picks the wrong column. Type the Notion property name exactly. The Notion Core admin page lists every column and what was detected."
    },
    {
      "name": "progress_prop",
      "type": "string",
      "label": "Progress column (blank = auto-detect)",
      "default": "",
      "help": "A number, formula or rollup. Percent-formatted values (0-1) and whole percentages (0-100) are both understood."
    },
    {
      "name": "due_prop",
      "type": "string",
      "label": "Target date column (blank = auto-detect)",
      "default": ""
    },
    {
      "name": "assignee_prop",
      "type": "string",
      "label": "Owner column (blank = auto-detect)",
      "default": ""
    },
    {
      "name": "done_prop",
      "type": "string",
      "label": "Done checkbox column (blank = auto-detect)",
      "default": ""
    }
  ],
  "fragments": [
    {
      "id": "full",
      "label": "Project list",
      "w": 320,
      "h": 220,
      "icon": "ph-kanban"
    },
    {
      "id": "count",
      "label": "Active count",
      "w": 120,
      "h": 120,
      "icon": "ph-briefcase"
    }
  ],
  "data_schema": {
    "fields": [
      {
        "name": "title",
        "type": "str",
        "label": "Title"
      },
      {
        "name": "total",
        "type": "num",
        "label": "Active projects"
      },
      {
        "name": "overdue_count",
        "type": "num",
        "label": "Past target date"
      },
      {
        "name": "avg_progress",
        "type": "num",
        "label": "Average progress (0-1)"
      },
      {
        "name": "items",
        "type": "arr",
        "label": "Projects"
      },
      {
        "name": "filtered_by",
        "type": "str",
        "label": "Filter in force"
      }
    ],
    "sample": {
      "title": "Projects",
      "items": [
        {
          "title": "Tesserae panel rollout",
          "status": "In progress",
          "done": false,
          "due_date": "2026-09-08",
