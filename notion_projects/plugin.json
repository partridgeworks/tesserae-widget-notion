          "owner": "",
          "progress": 0.1,
          "url": ""
        }
      ],
      "total": 3,
      "shown": 3,
      "overdue_count": 1,
      "empty": false,
      "has_due": true,
      "has_status": true,
      "has_progress": true,
      "avg_progress": 0.4166,
      "fetched_at": 1757500000,
      "account": "Work",
      "filtered_by": ""
    }
  }
}
