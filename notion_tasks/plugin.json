{
  "tesserae_compat": "1.x",
  "name": "Notion, Tasks",
  "version": "0.4.1",
  "kind": "widget",
  "description": "Open tasks from any Notion database, overdue first, with due dates, status and project, optionally grouped under project headers. Auto-detects which columns hold status, due date, priority and project, so it works on your schema without configuration. Supports several Notion accounts. Requires the Notion Core plugin.",
  "icon": "ph-list-checks",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:api.notion.com",
    "settings:plugin/notion_core"
  ],
  "render": {
    "needs_network": false
  },
  "cell_options": [
    {
      "name": "data_source",
      "type": "select",
      "label": "Database",
      "default": "",
      "choices_from": "data_sources",
      "help": "Every database your Notion accounts can see, prefixed by account name when more than one is configured. Picking one also selects that account: a Notion database belongs to exactly one workspace, so there is nothing else to choose. Nothing listed? Open the database in Notion, then \u2022\u2022\u2022 \u2192 Connections \u2192 add your integration."
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "placeholder": "Tasks",
      "default": "Tasks"
    },
    {
      "name": "limit",
      "type": "select",
      "label": "Max tasks shown",
      "default": "8",
      "choices": [
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "12",
          "label": "12"
        },
        {
          "value": "20",
          "label": "20"
        }
      ]
    },
    {
      "name": "refresh_min",
      "type": "select",
      "label": "Refresh",
      "default": "15",
      "choices": [
        {
          "value": "5",
          "label": "Every 5 min"
        },
        {
          "value": "15",
          "label": "Every 15 min"
        },
        {
          "value": "60",
          "label": "Hourly"
        }
      ]
    },
    {
      "name": "group_by",
      "type": "select",
      "label": "Group by",
      "default": "none",
      "choices": [
        {
          "value": "none",
          "label": "No grouping"
        },
        {
          "value": "project",
          "label": "Project"
        }
      ],
      "help": "Group tasks under a header row per project, using the Project column (auto-detected, or whatever the Project column option names). Tasks with no project collect under 'No project', last."
    },
    {
      "name": "show_group_header",
      "type": "boolean",
      "label": "Show group headings",
      "default": true,
      "help": "Only applies when Group by is set to Project. Turn it off to keep tasks bucketed and ordered by project without heading rows \u2014 each row then shows its own project name instead."
    },
    {
      "name": "show_due",
      "type": "boolean",
      "label": "Show due dates",
      "default": true
    },
    {
      "name": "show_project",
      "type": "boolean",
      "label": "Show project names",
      "default": true
    },
    {
      "name": "show_status",
      "type": "boolean",
      "label": "Show status chips",
      "default": true
    },
    {
      "name": "show_completed",
      "type": "boolean",
      "label": "Include completed tasks",
      "default": false,
      "help": "Off by default: a wall panel is for what's left, not what's finished."
    },
    {
      "name": "status_prop",
      "type": "string",
      "label": "Status column (blank = auto-detect)",
      "default": "",
      "help": "Only needed if auto-detection picks the wrong column. Type the Notion property name exactly. The Notion Core admin page lists every column and what was detected."
    },
    {
      "name": "due_prop",
      "type": "string",
      "label": "Due date column (blank = auto-detect)",
      "default": ""
    },
    {
      "name": "priority_prop",
      "type": "string",
      "label": "Priority column (blank = auto-detect)",
      "default": ""
    },
    {
      "name": "project_prop",
      "type": "string",
      "label": "Project column (blank = auto-detect)",
      "default": ""
    },
    {
      "name": "done_prop",
      "type": "string",
      "label": "Done checkbox column (blank = auto-detect)",
      "default": ""
    }
  ],
  "fragments": [
    {
      "id": "full",
      "label": "Task list",
      "w": 300,
      "h": 220,
      "icon": "ph-list-checks"
    },
    {
      "id": "count",
      "label": "Open count",
      "w": 120,
      "h": 120,
      "icon": "ph-number-circle-three"
    }
  ],
  "data_schema": {
    "fields": [
      {
        "name": "title",
        "type": "str",
        "label": "Title"
      },
      {
        "name": "total",
        "type": "num",
        "label": "Open tasks"
      },
      {
        "name": "overdue_count",
        "type": "num",
        "label": "Overdue tasks"
      },
      {
        "name": "today_count",
        "type": "num",
        "label": "Due today"
      },
      {
        "name": "items",
        "type": "arr",
        "label": "Tasks"
      },
      {
        "name": "groups",
        "type": "arr",
        "label": "Tasks grouped by project"
      }
    ],
    "sample": {
